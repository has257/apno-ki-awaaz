# Add this setting to .env and replace the placeholders with URL-encoded credentials.
DATABASE_URL=mysql+pymysql://<username>:<password>@localhost:3306/apno_ki_awaaz
# Generate a unique value with: openssl rand -base64 48
JWT_SECRET=<set-a-random-secret-at-least-32-bytes>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30